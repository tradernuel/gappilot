{
  "name": "gappilot",
  "version": "0.1.0",
  "private": true,
  "description": "Tokenized-stock opportunity detection on BNB Smart Chain, powered by the Binance Web3 API.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsx --env-file=.env.local scripts/smoke.ts",
    "scan": "tsx --env-file=.env.local scripts/scan.ts",
    "agent": "tsx --env-file=.env.local scripts/agent.ts",
    "build:demo": "node scripts/build-demo.mjs dist-demo/gappilot-test-app.html"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
