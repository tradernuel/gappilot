# ─────────────────────────────────────────────────────────────────────────────
# GapPilot environment variables
# Copy to .env.local for local dev. On Vercel, set these in Project → Settings →
# Environment Variables. NEVER prefix secrets with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────────

# ── Binance Web3 API (required) ──────────────────────────────────────────────
# Create a project + key at https://web3.binance.com/en/dev-portal
# Every endpoint GapPilot uses is HMAC-signed (X-OC-APIKEY / X-OC-TIMESTAMP / X-OC-SIGN).
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=

# Base URL including the /build path prefix. The prefix is part of the signed
# request path, so do not strip it. Default comes from the official connector.
BINANCE_WEB3_BASE_URL=https://web3.binance.com/build

# Sent as X-OC-RECV-WINDOW. Docs: default 5000, max 60000.
BINANCE_WEB3_RECV_WINDOW_MS=5000

# Per-request timeout. The official SDK defaults to 1000 ms, which is too
# tight for /quote and /swap on serverless cold starts.
BINANCE_WEB3_TIMEOUT_MS=10000

# ── Trading configuration (required) ─────────────────────────────────────────
# Stablecoin used as the cash leg for BUY/SELL quotes on BSC (chainId 56).
# This is a token *address*, not market data. Value below is BSC-USD (USDT) —
# verify on https://bscscan.com before use. Decimals are read at runtime from
# /market/token/basic-info, never hardcoded.
GAPPILOT_QUOTE_TOKEN_ADDRESS=0x55d398326f99059fF775485246999027B3197955

# ── Opportunity policy (optional; these are risk thresholds, not market data) ─
# Reject on-chain prices older than this (uses tokenPriceUpdatedAt from /rwa/price).
GAPPILOT_MAX_TOKEN_PRICE_AGE_MS=120000
# Minimum edge, AFTER estimated fees/impact/slippage, to flag as potentially actionable.
GAPPILOT_MIN_NET_EDGE_BPS=50
# Minimum summed pool liquidity (USD, from /market/token/top-liquidity).
GAPPILOT_MIN_LIQUIDITY_USD=25000

# ── Execution ────────────────────────────────────────────────────────────────
# Kill switch for LIVE execution. Simulated (mock) execution ignores it.
GAPPILOT_EXECUTION_ENABLED=false

# Execution provider. "mock" = SIMULATED execution (default; nothing is sent).
# "binance-agentic-wallet" = LIVE orders through the Binance Agentic Wallet CLI
# (`npm i -g @binance/agentic-wallet`, then `baw auth signin`). LIVE runs only in
# the local agent worker (`npm run agent`), never in the web app, and only with
# GAPPILOT_EXECUTION_ENABLED=true. Not verified against a live session yet.
GAPPILOT_EXECUTION_PROVIDER=mock
GAPPILOT_AGENTIC_CLI_PATH=baw
GAPPILOT_AGENTIC_CLI_VERSION_PREFIX=1.10.

# ── Logging & integration routes ─────────────────────────────────────────────
# Structured JSON logs. debug adds upstream error bodies (still secret-scrubbed).
LOG_LEVEL=info
# /api/binance/* integration routes are open in `next dev`. In production they
# return 404 unless this is set (≥16 chars) and requests send
# `Authorization: Bearer <token>`. Generate one: openssl rand -hex 24
GAPPILOT_DEBUG_ROUTES_TOKEN=

# ── Independent reference price (optional, see README "The reference-price problem")
# The Binance RWA API's `referencePrice` is derived from the on-chain token price,
# so it is NOT an independent TradFi quote. Supported values: none
# (Further providers are integration points; none is implemented in phase 1.)
GAPPILOT_REFERENCE_PROVIDER=none

# ── OpenAI (explanation layer only; required from phase 3) ───────────────────
# The LLM explains decisions computed deterministically by GapPilot. It never
# decides whether to trade and never sees API secrets.
OPENAI_API_KEY=
# Set explicitly; GapPilot does not guess a model name.
OPENAI_MODEL=
